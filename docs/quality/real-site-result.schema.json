{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niboshi.dev/fullscreen-chat-extension/real-site-result.schema.json",
  "title": "Real-site verification run result",
  "description": "Machine-checkable record for a Chrome or Firefox live-site review run. Schema validity is not product pass. Do not record chat bodies, viewer identifiers, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "startedAt",
    "actor",
    "environment",
    "browser",
    "build",
    "loginState",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Directory name under .harness-artifacts/real-site/"
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 start time"
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 finish time when finalized"
    },
    "actor": {
      "type": "string",
      "enum": ["agent", "human"]
    },
    "environment": {
      "type": "string",
      "const": "live-site"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": {
          "type": "string",
          "enum": ["chrome", "firefox"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mcp": {
          "type": "string",
          "minLength": 1,
          "description": "MCP server name and observed version when known"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "manifestSha256"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["chrome-mv3", "firefox-mv3"]
        },
        "outputDir": {
          "type": "string",
          "minLength": 1
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "contentScriptSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "description": "Dedicated verify profile path hint; never a personal browser profile"
    },
    "loginState": {
      "type": "string",
      "enum": ["logged-out", "logged-in-permitted", "unknown"]
    },
    "notes": {
      "type": "string",
      "description": "Run-level notes without chat text or secrets"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(YL|YA|YC|TL|TV|X)-[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "conditional", "not-run", "blocked", "na"],
            "description": "判定値は pass（合格）、fail（失敗）、conditional（条件付き）、not-run（未実施）、blocked（実行不能）、na（対象外）。"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Path relative to the run directory"
            }
          },
          "url": {
            "type": "string",
            "description": "Page URL without tokens or personal query data when possible"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
