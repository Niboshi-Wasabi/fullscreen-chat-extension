{
  "name": "fullscreen-chat-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Fullscreen chat overlay for YouTube and Twitch",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "prettier --write src scripts tests .github *.ts *.mjs *.cjs *.json pnpm-workspace.yaml",
    "format:check": "prettier --check src scripts tests .github *.ts *.mjs *.cjs *.json pnpm-workspace.yaml",
    "lint": "eslint src scripts tests eslint.config.mjs vitest.config.ts playwright.config.ts wxt.config.ts --max-warnings=0",
    "check:docs": "node scripts/verify-docs.mjs",
    "check:japanese": "python -IB tools/japanese-guard/check.py",
    "check:locales": "node scripts/verify-locales.mjs",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "check:manifests": "node scripts/verify-manifests.mjs",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "tools:setup": "node scripts/setup-ci-tools.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:security": "node scripts/verify.mjs --security",
    "verify:ci": "node scripts/verify.mjs --ci",
    "browser:setup": "node scripts/setup-browser.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "trace:e2e": "node node_modules/@playwright/test/cli.js show-trace --host 127.0.0.1 --port 0",
    "test:e2e:chrome": "node scripts/run-e2e.mjs --browser=chrome",
    "test:e2e:firefox": "node scripts/run-firefox-synthetic.mjs",
    "verify:browser": "node scripts/verify.mjs --browser=chromium",
    "verify:chrome": "node scripts/verify.mjs --browser=chrome",
    "real-site:init": "node scripts/real-site-run.mjs init",
    "real-site:finalize": "node scripts/real-site-run.mjs finalize",
    "check:real-site": "node scripts/check-real-site-results.mjs",
    "check:regression-links": "node scripts/check-regression-links.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wxt": "^0.21.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
